<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Service Requests - CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/residents.css">
  <link rel="stylesheet" href="/css/service-requests.css">
</head>
<body>
  <%- include('../partials/nav', { activePage: 'serviceRequests' }) %>
  <div class="page-container">
    <header class="page-header">
      <h1>Service Request Management</h1>
      <a href="/service-requests/new" class="btn btn-primary">+ Submit Service Request</a>
    </header>

    <% if (flash) { %>
      <div class="alert alert-success"><%= flash %></div>
    <% } %>

    <section class="search-section">
      <form method="GET" action="/service-requests" class="search-form">
        <div class="search-row">
          <div class="search-field">
            <label for="search">Search</label>
            <input type="text" id="search" name="search"
              value="<%= searchTerm %>"
              placeholder="Search by service type or description..."
              class="input">
          </div>
          <div class="search-field">
            <label for="status">Status</label>
            <select id="status" name="status" class="input">
              <option value="" <%= statusFilter === '' ? 'selected' : '' %>>All Statuses</option>
              <option value="Pending"     <%= statusFilter === 'Pending'     ? 'selected' : '' %>>Pending</option>
              <option value="In Progress" <%= statusFilter === 'In Progress' ? 'selected' : '' %>>In Progress</option>
              <option value="Completed"   <%= statusFilter === 'Completed'   ? 'selected' : '' %>>Completed</option>
              <option value="Cancelled"   <%= statusFilter === 'Cancelled'   ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
          <div class="search-actions">
            <button type="submit" class="btn btn-secondary">Search</button>
            <a href="/service-requests" class="btn btn-ghost">Clear</a>
          </div>
        </div>
      </form>
    </section>

    <section class="sr-section">
      <% if (serviceRequests.length === 0) { %>
        <p class="empty-message">No Service Requests found.</p>
      <% } else { %>
        <table class="residents-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Resident ID</th>
              <th>Service Type</th>
              <th>Date Requested</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% serviceRequests.forEach(sr => { %>
              <tr>
                <td><%= sr.id %></td>
                <td><%= sr.residentId %></td>
                <td><%= sr.serviceType %></td>
                <td><%= sr.dateRequested %></td>
                <td><span class="sr-status sr-status-<%= sr.status.toLowerCase().replace(' ', '-') %>"><%= sr.status %></span></td>
                <td>
                  <a href="/service-requests/<%= sr.id %>" class="btn btn-sm btn-secondary">View</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </div>
</body>
</html>
